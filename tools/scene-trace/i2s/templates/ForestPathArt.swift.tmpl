import SwiftUI

/// Pure-vector forest path scene, traced from the 937×1678 reference artwork and
/// aspect-filled into whatever size it is given.
struct ForestPathIllustration: View {
    var body: some View {
        ForestPathLayers(ForestPathArt.LayerID.allCases)
    }
}

/// Draws a subset of the scene's layers in their original positions. Split the
/// scene into several of these to animate or restyle one element on its own, e.g.
/// `ForestPathLayers([.fox]).offset(x: 20)` between the layers below and above it.
struct ForestPathLayers: View {
    let ids: [ForestPathArt.LayerID]

    init(_ ids: [ForestPathArt.LayerID]) {
        self.ids = ids
    }

    var body: some View {
        Canvas { context, size in
            context.concatenate(ForestPathArt.fillTransform(for: size))
            for id in ids {
                ForestPathArt.draw(id, in: &context)
            }
            // Soft shading: a blurred copy of the same layers, kept only inside the soft
            // zones (everywhere away from hard edges) with feathered borders, so gradients
            // read smooth while outlines stay crisp.
            context.drawLayer { layer in
                var blurred = layer
                blurred.addFilter(.blur(radius: ForestPathArt.shadingSoftness))
                blurred.drawLayer { inner in
                    for id in ids {
                        ForestPathArt.draw(id, in: &inner)
                    }
                }
                var mask = layer
                mask.blendMode = .destinationIn
                mask.addFilter(.blur(radius: ForestPathArt.softZoneFeather))
                mask.fill(ForestPathArt.softZones, with: .color(.white), style: FillStyle(eoFill: true))
            }
        }
    }
}

enum ForestPathArt {
    static let size = CGSize(width: 937, height: 1678)

    /// Named layers, back to front.
    enum LayerID: CaseIterable {
        case @CASES@
    }

    /// One filled shape: a flat colour or a two-stop linear gradient.
    struct Shape {
        let shading: GraphicsContext.Shading
        let path: Path
    }

    static func shapes(of id: LayerID) -> [Shape] {
        parsed[id] ?? []
    }

    static func draw(_ id: LayerID, in context: inout GraphicsContext) {
        for shape in shapes(of: id) {
            context.fill(shape.path, with: shape.shading, style: FillStyle(eoFill: true))
        }
    }

    /// Maps the design space onto `viewSize` with aspect-fill, centred.
    static func fillTransform(for viewSize: CGSize) -> CGAffineTransform {
        let scale = max(viewSize.width / size.width, viewSize.height / size.height)
        return CGAffineTransform(
            translationX: (viewSize.width - size.width * scale) / 2,
            y: (viewSize.height - size.height * scale) / 2
        )
        .scaledBy(x: scale, y: scale)
    }

    /// Blur radius of the soft shading pass, in design-space units.
    static let shadingSoftness: CGFloat = 2.5

    /// Feather on the soft-zone borders, in design-space units.
    static let softZoneFeather: CGFloat = 1

    /// Areas that receive the soft shading pass, parsed from `softZoneData`.
    static let softZones: Path = {
        var data = softZoneData
        return data.withUTF8 { bytes in
            var reader = ShapeDataReader(bytes)
            return reader.path(acrossLines: true)
        }
    }()

    /// Shapes per layer, parsed once on first use.
    private static let parsed: [LayerID: [Shape]] = Dictionary(uniqueKeysWithValues: LayerID.allCases.map { id in
        var data = data(of: id)
        let shapes = data.withUTF8 { bytes in
            var reader = ShapeDataReader(bytes)
            var shapes: [Shape] = []
            while let shape = reader.nextShape() {
                shapes.append(shape)
            }
            return shapes
        }
        return (id, shapes)
    })

    /// Raw data for a layer, one shape per line, back to front. Each line is
    /// `RRGGBB <path>` for a flat fill, or `RRGGBB RRGGBB x0 y0 x1 y1 <path>` for a
    /// linear gradient from (x0, y0) to (x1, y1). `<path>` is SVG path data
    /// (M, L, C, Z and relative l, c) in design-space units.
    static func data(of id: LayerID) -> String {
        switch id {
@SWITCH@
        }
    }
}

/// Single-pass reader for `ForestPathArt` layer data.
private struct ShapeDataReader {
    private let bytes: UnsafeBufferPointer<UInt8>
    private var index = 0

    init(_ bytes: UnsafeBufferPointer<UInt8>) {
        self.bytes = bytes
    }

    mutating func nextShape() -> ForestPathArt.Shape? {
        while index < bytes.count, bytes[index] == .space || bytes[index] == .newline {
            index += 1
        }
        guard index < bytes.count else { return nil }
        let from = color()
        skipSpaces()
        let shading: GraphicsContext.Shading
        if index < bytes.count, bytes[index] == UInt8(ascii: "M") {
            shading = .color(from)
        } else {
            let to = color()
            let start = point(), end = point()
            shading = .linearGradient(Gradient(colors: [from, to]), startPoint: start, endPoint: end)
        }
        return ForestPathArt.Shape(shading: shading, path: path(acrossLines: false))
    }

    /// Reads path commands up to the end of the line, or of the data if `acrossLines`.
    mutating func path(acrossLines: Bool) -> Path {
        var path = Path()
        var current = CGPoint.zero
        var subpathStart = CGPoint.zero
        while true {
            skipSpaces()
            if acrossLines {
                while index < bytes.count, bytes[index] == .newline || bytes[index] == .space {
                    index += 1
                }
            }
            guard index < bytes.count, bytes[index] != .newline else { return path }
            let command = bytes[index]
            index += 1
            switch command {
            case UInt8(ascii: "M"):
                current = point()
                subpathStart = current
                path.move(to: current)
            case UInt8(ascii: "L"), UInt8(ascii: "l"):
                current = point(from: command == UInt8(ascii: "l") ? current : .zero)
                path.addLine(to: current)
            case UInt8(ascii: "C"), UInt8(ascii: "c"):
                let origin = command == UInt8(ascii: "c") ? current : .zero
                let control1 = point(from: origin)
                let control2 = point(from: origin)
                current = point(from: origin)
                path.addCurve(to: current, control1: control1, control2: control2)
            case UInt8(ascii: "Z"):
                path.closeSubpath()
                current = subpathStart
            default:
                return path
            }
        }
    }

    private mutating func color() -> Color {
        var value = 0
        for _ in 0..<6 where index < bytes.count {
            let byte = bytes[index]
            value = value << 4 | Int(byte >= UInt8(ascii: "A") ? byte - UInt8(ascii: "A") + 10 : byte - UInt8(ascii: "0"))
            index += 1
        }
        return Color(
            red: Double((value >> 16) & 0xFF) / 255,
            green: Double((value >> 8) & 0xFF) / 255,
            blue: Double(value & 0xFF) / 255
        )
    }

    private mutating func point(from origin: CGPoint = .zero) -> CGPoint {
        let x = number()
        return CGPoint(x: origin.x + x, y: origin.y + number())
    }

    private mutating func number() -> CGFloat {
        skipSpaces()
        var negative = false
        if index < bytes.count, bytes[index] == UInt8(ascii: "-") {
            negative = true
            index += 1
        }
        var value = 0.0
        while index < bytes.count, bytes[index] &- UInt8(ascii: "0") < 10 {
            value = value * 10 + Double(bytes[index] &- UInt8(ascii: "0"))
            index += 1
        }
        if index < bytes.count, bytes[index] == UInt8(ascii: ".") {
            index += 1
            var scale = 0.1
            while index < bytes.count, bytes[index] &- UInt8(ascii: "0") < 10 {
                value += Double(bytes[index] &- UInt8(ascii: "0")) * scale
                scale *= 0.1
                index += 1
            }
        }
        return CGFloat(negative ? -value : value)
    }

    private mutating func skipSpaces() {
        while index < bytes.count, bytes[index] == .space || bytes[index] == UInt8(ascii: ",") {
            index += 1
        }
    }
}

private extension UInt8 {
    static let space = UInt8(ascii: " ")
    static let newline = UInt8(ascii: "\n")
}
